# DeepSeek API 密钥：https://platform.deepseek.com（默认辩手与裁判都用 DeepSeek，不用可以不填）
DEEPSEEK_API_KEY=
# 智谱 API 密钥：https://bigmodel.cn（使用 GLM-5.3 时填写）
ZHIPU_API_KEY=
# 阿里云百炼 API 密钥：https://bailian.console.aliyun.com（使用千问 Qwen3.8-Max 时填写）
DASHSCOPE_API_KEY=

# ---------- 模型 ----------
# 辩手的模型与思考强度在发起辩论时按队伍选择（同队四人一致），这里只是表单的默认选项。
# 可选：deepseek-flash、deepseek-v4-pro、glm-5.3、qwen3.8-max
DEBATE_MODEL=deepseek-flash
# 思考强度：DeepSeek / 智谱为 low / high / max，千问为 low / medium / xhigh；不填用模型默认档位
DEBATE_REASONING_EFFORT=
# 裁判组与证据核查员（不随队伍变化）
JUDGE_MODEL=deepseek-flash
JUDGE_REASONING_EFFORT=high

# ---------- 联网检索 ----------
# 博查搜索 API 密钥：https://open.bocha.cn
# 不填则跳过资料检索，辩手只能进行推理论证
BOCHA_API_KEY=
# 每次搜索返回的网页条数（1-50）
WEB_SEARCH_RESULTS_PER_QUERY=8
# 每位辩手赛前检索次数（只有赛前准备可以检索，立论开始前证据库封存）
SEARCHES_PER_DEBATER=3
# 每方证据库最多收集多少条（默认 20，最多 30），按辩位平均分给四位辩手
EVIDENCE_PER_SIDE=20
# 每方全场最多使用多少条证据：一条证据第一次在发言中被引用算用掉一条，之后回指不再计数
MAX_EVIDENCE_USED_PER_SIDE=9
# 打开网页核对原文的超时（毫秒）
PAGE_FETCH_TIMEOUT_MS=8000
# 额外屏蔽的站点（逗号分隔）。默认已屏蔽转载 / 自媒体平台、文库站和学术数据库，完整名单见 src/config.ts
BLOCKED_DOMAINS=

# ---------- 赛制与论证约束 ----------
# 三辩质询时向对方一辩、二辩各提几个问题
CROSS_QUESTIONS_PER_TARGET=2
# 自由辩论总发言次数（双方交替）
FREE_DEBATE_TURNS=8
# 每方最多质疑对方证据的次数
MAX_CHALLENGES_PER_SIDE=3
# 每个论点最多引用几条证据；一段发言中「含引用的句子」最多占多少
MAX_EVIDENCE_PER_POINT=2
MAX_CITATION_RATIO=0.45

# 正常语速（每分钟字数），用于估算发言时长
SPEECH_CHARS_PER_MINUTE=240
# 立论目标时长（分钟），按上面的语速换算字数；落在可接受范围内不要求修改
OPENING_MINUTES=8
OPENING_MIN_MINUTES=6
OPENING_MAX_MINUTES=9

# 服务端口
PORT=3000

# 设为 1 进入演示模式：不调用 API、不联网，用占位数据跑通完整流程
DEBATE_MOCK=0
